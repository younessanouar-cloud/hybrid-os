# =====================================================================
# HYBRID OS — image desktop (Phase 2/3)
# Structure MULTI-STAGE :
#   - stage « builder » : toolchain C++ (jamais dans l'image finale)
#   - stage final : l'image bootc avec l'identité OPALE + les apps natives
# =====================================================================

# ----- Stage 1 : compilation des applications natives -----
ARG BASE_IMAGE="quay.io/fedora/fedora-kinoite:45"
FROM ${BASE_IMAGE} AS builder

RUN dnf -y install gcc-c++ cmake qt6-qtdeclarative-devel qt6-qtquickcontrols2-devel \
    && dnf clean all

# Security Center (Phase 3 ébauche — sources réelles, doc 06)
COPY applications/security-center /src/security-center
RUN cmake -S /src/security-center -B /src/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /src/build --parallel \
    && cmake --install /src/build --prefix /inst

# ----- Stage 2 : image finale bootc -----
FROM ${BASE_IMAGE}

# --- 1. Localisation française ---
RUN dnf -y install glibc-langpack-fr hunspell-fr \
    && dnf clean all

# --- 2. Fond d'écran OPALE ---
COPY branding/opale/opale-nuit-3840x2160.png \
     /usr/share/wallpapers/OpaleNuit/contents/images/3840x2160.png
COPY branding/opale/wallpapers/metadata.desktop \
     /usr/share/wallpapers/OpaleNuit/metadata.desktop

# --- 3. Palette système OPALE ---
COPY branding/opale/colors/HybridOpale.colors \
     /usr/share/color-schemes/HybridOpale.colors

# --- 4. Look-and-feel OPALE (thèmes, splash, disposition bureau) ---
COPY branding/opale/look-and-feel/com.hybridos.opale/ \
     /usr/share/plasma/look-and-feel/com.hybridos.opale/
COPY build/kdeglobals.hybridos /etc/xdg/kdeglobals

# --- 5. Écran de connexion SDDM OPALE ---
COPY branding/opale/sddm/hybridos-opale/ \
     /usr/share/sddm/themes/hybridos-opale/
COPY branding/opale/sddm/hybridos.conf /etc/sddm.conf.d/hybridos.conf

# --- 6. Bibliothèque de composants OPALE (apps natives — doc 07 §6) ---
COPY applications/libopale/ \
     /usr/lib64/qt6/qml/org/hybridos/opale/

# --- 7. Icônes de marque OPALE (hicolor — start-here = lanceur du dock) ---
COPY branding/opale/icons/hicolor/ \
     /usr/share/icons/hicolor/

# --- 8. Application native : Security Center (compilée au stage 1) ---
COPY --from=builder /inst/bin/hybrid-security-center /usr/bin/
COPY applications/security-center/hybrid-security-center.desktop \
     /usr/share/applications/

# --- 9. Mode graphique EXPLICITE (le kickstart texte installe en console) ---
# Pattern bootc documenté : systemctl enable/set-default fonctionne offline
# dans le build d'image ; garanti SDDM actif + cible graphical au premier boot.
RUN systemctl enable sddm.service \
    && systemctl set-default graphical.target

LABEL org.opencontainers.image.title="HYBRID OS desktop" \
      org.opencontainers.image.description="HYBRID OS desktop — Fedora Kinoite (Atomic KDE) + design system OPALE complet + Security Center natif (sources réelles)" \
      org.opencontainers.image.vendor="HYBRID OS Project" \
      org.opencontainers.image.licenses="ASL-2.0 AND BSD-2-Clause AND BSD-3-Clause AND GPL-2.0-or-later AND LGPL-2.1-or-later AND MIT" \
      org.opencontainers.image.base.name="quay.io/fedora/fedora-kinoite:45" \
      org.hybridos.version="0.3.0-alpha.1" \
      org.hybridos.phase="phase2-3-interface-securite"
